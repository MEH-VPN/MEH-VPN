rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidConnectionLog(data, userId) {
      return data.userId is string && data.userId == request.auth.uid && data.userId == userId &&
             data.countryNameFa is string && data.countryNameFa.size() >= 1 && data.countryNameFa.size() <= 60 &&
             data.flagEmoji is string && data.flagEmoji.size() >= 1 && data.flagEmoji.size() <= 20 &&
             data.rawUri is string && data.rawUri.size() >= 1 && data.rawUri.size() <= 2048 &&
             data.sourceRepo is string && data.sourceRepo.size() >= 1 && data.sourceRepo.size() <= 200 &&
             data.pingMs is int && data.pingMs >= 0 && data.pingMs <= 60000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId}/connection_logs/{logId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(logId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(logId) &&
                       incoming().keys().hasAll(['userId', 'countryNameFa', 'flagEmoji', 'rawUri', 'sourceRepo', 'pingMs', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'countryNameFa', 'flagEmoji', 'rawUri', 'sourceRepo', 'pingMs', 'createdAt', 'updatedAt']) &&
                       isValidConnectionLog(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(logId) &&
                       isValidConnectionLog(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['countryNameFa', 'flagEmoji', 'rawUri', 'sourceRepo', 'pingMs', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(logId);
    }
  }
}
